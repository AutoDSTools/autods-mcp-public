MCP_ENV=local
COGNITO_USER_POOL_ID=us-west-2_qwerty
COGNITO_REGION=us-west-2
ALLOWED_COGNITO_CLIENT_IDS=["qwerty"]

# Phase C — OAuth discovery + DCR shim. COGNITO_PUBLIC_CLIENT_ID and
# COGNITO_DOMAIN are required in every environment; the settings refuse to
# boot without them.
# COGNITO_PUBLIC_CLIENT_ID is returned by /oauth/register; must also be in
# ALLOWED_COGNITO_CLIENT_IDS or the settings will refuse to boot.
COGNITO_PUBLIC_CLIENT_ID=qwerty
# Cognito Hosted UI domain — bare hostname or full URL.
COGNITO_DOMAIN=auth.example.com
# Allowlisted redirect URIs the DCR shim will echo back. Mirror the URIs
# pre-registered on the Cognito client itself.
MCP_REGISTRATION_REDIRECT_URIS=["https://claude.com/api/mcp/auth_callback","https://claude.ai/api/mcp/auth_callback","http://localhost:6274/oauth/callback","http://localhost:8000/callback"]

# Phase D — MCP runtime. Directory the tool manifests are loaded from.
# Defaults to the bundled manifests/ (vendored products.json); set to an
# empty directory to run the transport with zero tools.
# MCP_MANIFEST_DIR=manifests

LOG_LEVEL=DEBUG

# Upstream base URLs. Each defaults to the production host, so a local run
# against staging sets all three.
# AUTODS_API_BASE_URL=https://v2-api-staging.autods.com
# PRODUCTS_RESEARCH_BASE_URL=https://gw-staging.autods.com/marketplace/api
# RD-95 — the supplier scans. Must be the API gateway's /suppliers route, never
# the scrapers service directly: the gateway swaps the caller's token for one
# the service accepts, so a direct URL reaches it with a token it rejects.
# SCRAPERS_API_BASE_URL=https://gw-staging.autods.com/suppliers

# Phase F — Redis-backed per-user rate limiting. REDIS_URL is required in
# staging/prod (the limiter is shared across replicas); in local it's optional
# and an unset value falls back to an in-process limiter. docker-compose points
# this at the bundled redis sidecar.
# REDIS_URL=redis://localhost:6379/0
# Per-user ceilings (token buckets keyed by the Cognito sub); both apply.
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000

# RD-92 — the opt-in base64 thumbnail path (`include_images: true`). All three
# bound work done on the tool-call path against supplier CDNs we do not control,
# so a host that turns slow is survivable by config rather than by a release.
# The image cap itself (20 x 252px) is deliberately NOT configurable: it is a
# correctness bound derived from the client's silent truncation threshold.
# IMAGE_FETCH_TIMEOUT_SECONDS is httpx's PER-OPERATION timeout, and on a
# streamed body its read timeout restarts on every chunk — so it does not bound
# how long a download can last. IMAGE_FETCH_DEADLINE_SECONDS is the bound on
# elapsed time, across every image in one call, and is the only thing standing
# between a trickling host and a tool call that never returns.
# IMAGE_FETCH_TIMEOUT_SECONDS=5
# IMAGE_FETCH_MAX_BYTES=8000000
# IMAGE_FETCH_DEADLINE_SECONDS=15

# RD-92 — the AutoDS web app a rendered product links to. Derived from MCP_ENV
# (prod -> platform.autods.com, everything else -> v2-staging.autods.com), so a
# deploy needs nothing here; set it only to point a local run at another host.
# Getting this wrong is silent: a link into the wrong environment resolves and
# loads, it just shows someone else's catalogue.
# AUTODS_APP_BASE_URL=https://v2-staging.autods.com

# Sentry error/performance reporting (self-hosted sentry.autods.com).
# All optional: unset SENTRY_URL (or MCP_ENV=local) makes init a no-op, so
# local dev sends no events. In staging/prod SENTRY_URL is delivered via
# External Secrets and SENTRY_ENVIRONMENT via the deploy chart; the release is
# derived from the package __version__ in code.
# SENTRY_URL=https://<public_key>@sentry.autods.com/<project_id>
# SENTRY_ENVIRONMENT defaults to MCP_ENV when unset.
# SENTRY_ENVIRONMENT=local
